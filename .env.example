# HTTP port used by Express
PORT=3000

# Comma-separated browser origins allowed to open a Socket.IO connection.
# Leave empty for same-origin deployments.
ALLOWED_ORIGINS=

# Set to true when running behind one trusted reverse proxy (for example Hostinger/Nginx).
TRUST_PROXY=true

# Optional fixed secret (minimum 32 characters) used to encrypt the installer configuration.
# If omitted, Sublevel creates a secure random secret in .sublevel-data automatically.
SUBLEVEL_APP_SECRET=

# Optional writable directory for encrypted runtime configuration.
# Leave empty to use .sublevel-data inside the application directory.
SUBLEVEL_DATA_DIR=

# Number of days an authenticated browser session remains valid.
SESSION_DAYS=30

# Maximum number of pooled MySQL/MariaDB connections.
DB_POOL_SIZE=10

# Maximum number of anonymous live-sync sessions kept in memory.
MAX_LIVE_SESSIONS=500

# Remove inactive live-sync sessions after this many milliseconds (default: 24 hours).
LIVE_SESSION_TTL_MS=86400000
